# ==============================================
# Terraform
# ==============================================

# 로컬 .terraform 디렉토리 (provider 바이너리, 모듈 캐시)
**/.terraform/*

# tfstate 파일 (민감 정보 포함 가능, 원격 backend 사용 권장)
*.tfstate
*.tfstate.*
*.tfstate.backup

# 플랜 파일
*.tfplan
*.plan

# 변수 파일 (민감 정보 포함 가능)
# db_admin_password 등 평문 자격증명이 포함되므로 git 추적 차단
*.tfvars.json
# *.tfvars

# crash log
crash.log
crash.*.log

# lock 파일은 올리는 게 권장됨 (주석 처리)
# .terraform.lock.hcl

# ==============================================
# 운영체제
# ==============================================
.DS_Store
Thumbs.db

# ==============================================
# 에디터
# ==============================================
.vscode/
.idea/
*.swp
*.swo

# ==============================================
# 임시 격리 백업 파일
# ==============================================
*.ignore
