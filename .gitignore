# ==============================================
# Terraform
# ==============================================

# 로컬 .terraform 디렉토리 (provider 바이너리, 모듈 캐시)
**/.terraform/*

# tfstate 파일 (민감 정보 포함 가능, 원격 backend 사용 권장)
*.tfstate
*.tfstate.*
*.tfstate.backup

# 플랜 파일
*.tfplan
*.plan

# 변수 파일 (민감 정보 포함 가능)
*.tfvars.json
# 아래 줄은 tfvars를 올리고 싶다면 주석 처리하세요
# *.tfvars

# crash log
crash.log
crash.*.log

# lock 파일은 올리는 게 권장됨 (주석 처리)
# .terraform.lock.hcl

# ==============================================
# 운영체제
# ==============================================
.DS_Store
Thumbs.db

# ==============================================
# 에디터
# ==============================================
.vscode/
.idea/
*.swp
*.swo

# Terraform auto-generated K8s manifests
# (ArgoCD 배포를 위해 Github에 푸시되어야 하므로 주석 처리)
# modules/infra/k8s-manifests/overlays/**/*.env
# modules/infra/k8s-manifests/overlays/**/*-patch.yaml
